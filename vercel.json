{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/cv.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Darya-Mohammadi-CV.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
